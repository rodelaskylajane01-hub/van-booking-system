<%- include("partials/user-shell-start") %><div class="booking-layout"><section class="panel"><a href="/trips" class="back-link">← Back to trips</a><h2>Select Seats</h2><div class="route-banner"><b><%= schedule.route.origin %> → <%= schedule.route.destination %></b><span><%= new Date(schedule.departureAt).toLocaleString() %></span><strong>₱<%= schedule.fare %> / seat</strong></div><div class="legend"><span><i class="seat available"></i> Available</span><span><i class="seat selected"></i> Selected</span><span><i class="seat occupied"></i> Occupied</span></div><form action="/bookings" method="POST" id="seatForm"><input type="hidden" name="scheduleId" value="<%= schedule._id %>"><div class="seat-grid"><% for(let n=1;n<=schedule.van.capacity;n++){ %><label class="seat-label"><input type="checkbox" name="seats" value="<%= n %>" <%= occupied.includes(n)?"disabled":"" %>><span class="seat <%= occupied.includes(n)?"occupied":"available" %>"><%= n %></span></label><% } %></div><p class="muted small">Select one or more available seats. Occupied seats cannot be selected.</p><button class="btn btn-primary full" type="submit">Confirm Booking</button></form></section><aside class="panel summary-panel"><h2>Booking Summary</h2><p><span>Route</span><b><%= schedule.route.origin %> → <%= schedule.route.destination %></b></p><p><span>Departure</span><b><%= new Date(schedule.departureAt).toLocaleString() %></b></p><p><span>Van</span><b><%= schedule.van.name %></b></p><hr><p><span>Selected seats</span><b id="seatCount">0</b></p><p class="total"><span>Total</span><b id="seatTotal">₱0</b></p></aside></div><script>window.seatFare=<%= schedule.fare %>;</script><%- include("partials/user-shell-end") %>