<%- include("../partials/admin-shell-start") %><section class="panel"><h2>Create Departure Schedule</h2><form method="POST" action="/admin/schedules" class="form-grid"><label>Route<select name="route" required><% routes.forEach(r=>{ %><option value="<%= r._id %>"><%= r.origin %> → <%= r.destination %></option><% }) %></select></label><label>Van<select name="van" required><% vans.forEach(v=>{ %><option value="<%= v._id %>"><%= v.name %> · <%= v.plateNumber %> · <%= v.capacity %> seats</option><% }) %></select></label><label>Driver<select name="driver"><option value="">Not assigned</option><% drivers.forEach(d=>{ %><option value="<%= d._id %>"><%= d.fullName %></option><% }) %></select></label><label>Departure date & time<input type="datetime-local" name="departureAt" required></label><label>Arrival date & time<input type="datetime-local" name="arrivalAt"></label><label>Fare per seat (₱)<input type="number" name="fare" min="0" required></label><button class="btn btn-primary">Create Schedule</button></form></section><div class="section-title"><h2>Departure Schedules</h2></div><div class="manage-list"><% items.forEach(x=>{ %><form class="manage-row schedule-row" method="POST" action="/admin/schedules/<%= x._id %>/update"><div class="schedule-desc"><b><%= x.route?x.route.origin+" → "+x.route.destination:"Route unavailable" %></b><small><%= x.van?x.van.name:"Van unavailable" %> · <%= x.driver?x.driver.fullName:"No driver assigned" %></small></div><label>Departure<input type="datetime-local" name="departureAt" value="<%= new Date(x.departureAt).toISOString().slice(0,16) %>"></label><label>Fare<input type="number" name="fare" value="<%= x.fare %>"></label><label>Status<select name="status"><% ["Scheduled","Departed","Completed","Cancelled"].forEach(s=>{ %><option <%= x.status===s?"selected":"" %>><%= s %></option><% }) %></select></label><button class="btn btn-primary btn-small">Save</button><button class="btn btn-danger btn-small" formaction="/admin/schedules/<%= x._id %>/delete" formmethod="POST" onclick="return confirm('Delete schedule?')">Delete</button></form><% }) %></div><%- include("../partials/admin-shell-end") %>