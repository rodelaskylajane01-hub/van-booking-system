<%- include("../partials/admin-shell-start") %><div class="stats-grid"><div class="stat-card"><span>Confirmed booking revenue</span><b>₱<%= revenue.toLocaleString() %></b><small>Based on confirmed bookings</small></div><div class="stat-card"><span>Total booking records</span><b><%= bookings.length %></b><small>All booking statuses</small></div></div><section class="panel table-wrap"><div class="section-title"><h2>Booking Report</h2><button class="btn btn-outline btn-small" onclick="window.print()">Print report</button></div><table><thead><tr><th>Booking No.</th><th>Passenger</th><th>Route</th><th>Seats</th><th>Total</th><th>Status</th><th>Date booked</th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><%= b.bookingNumber %></td><td><%= b.passenger?b.passenger.fullName:"—" %></td><td><%= b.schedule&&b.schedule.route?b.schedule.route.origin+" → "+b.schedule.route.destination:"—" %></td><td><%= b.seats.join(", ") %></td><td>₱<%= b.total %></td><td><%= b.status %></td><td><%= new Date(b.createdAt).toLocaleDateString() %></td></tr><% }) %></tbody></table></section><%- include("../partials/admin-shell-end") %>