<%- include("../partials/admin-shell-start") %><section class="panel"><h2>Add Van Route</h2><form method="POST" action="/admin/routes" class="form-grid"><label>Origin<input name="origin" placeholder="Cajidiocan" required></label><label>Destination<input name="destination" placeholder="San Andres" required></label><label>Fare (₱)<input type="number" name="fare" min="0" required></label><label>Distance / Notes<input name="distance"></label><button class="btn btn-primary">Add Route</button></form></section><div class="section-title"><h2>Route Records</h2></div><div class="manage-list"><% items.forEach(x=>{ %><form class="manage-row" method="POST" action="/admin/routes/<%= x._id %>/update"><label>Origin<input name="origin" value="<%= x.origin %>"></label><label>Destination<input name="destination" value="<%= x.destination %>"></label><label>Fare<input type="number" name="fare" value="<%= x.fare %>"></label><label>Notes<input name="distance" value="<%= x.distance %>"></label><label class="check-label"><input type="checkbox" name="active" <%= x.active?"checked":"" %>> Active</label><button class="btn btn-primary btn-small">Save</button><button class="btn btn-danger btn-small" formaction="/admin/routes/<%= x._id %>/delete" formmethod="POST" onclick="return confirm('Delete this route?')">Delete</button></form><% }) %></div><%- include("../partials/admin-shell-end") %>