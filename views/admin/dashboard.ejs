<%- include("../partials/admin-shell-start") %><div class="stats-grid"><div class="stat-card"><span>Passenger Records</span><b><%= stats.passengers %></b><small>Registered passengers</small></div><div class="stat-card"><span>Van Records</span><b><%= stats.vans %></b><small>Vehicles in system</small></div><div class="stat-card"><span>Van Routes</span><b><%= stats.routes %></b><small>Configured routes</small></div><div class="stat-card"><span>Schedules</span><b><%= stats.schedules %></b><small>Departure schedules</small></div><div class="stat-card"><span>Booking Records</span><b><%= stats.bookings %></b><small>All reservations</small></div><div class="stat-card"><span>Confirmed Bookings</span><b><%= stats.confirmed %></b><small>Active reservations</small></div></div><div class="quick-grid"><a href="/admin/routes">⌁<b>Manage Routes</b><small>Add, edit, delete routes</small></a><a href="/admin/vans">🚐<b>Manage Vans</b><small>Capacity and availability</small></a><a href="/admin/drivers">♙<b>Manage Drivers</b><small>Driver information</small></a><a href="/admin/schedules">▣<b>Departure Schedules</b><small>Set trip times and fares</small></a><a href="/admin/bookings">▤<b>Passenger Bookings</b><small>View reservations</small></a><a href="/admin/records">▦<b>Database Records</b><small>View record counts</small></a></div><section class="panel table-wrap"><div class="section-title"><h2>Recent Bookings</h2><a href="/admin/bookings">View all →</a></div><table><thead><tr><th>Booking No.</th><th>Passenger</th><th>Route</th><th>Total</th><th>Status</th></tr></thead><tbody><% recent.forEach(b=>{ %><tr><td><%= b.bookingNumber %></td><td><%= b.passenger?b.passenger.fullName:"—" %></td><td><%= b.schedule&&b.schedule.route?b.schedule.route.origin+" → "+b.schedule.route.destination:"—" %></td><td>₱<%= b.total %></td><td><%= b.status %></td></tr><% }) %></tbody></table></section><%- include("../partials/admin-shell-end") %>