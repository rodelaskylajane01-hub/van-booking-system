<%- include("../partials/admin-shell-start") %><section class="panel"><h2>Add Van</h2><form method="POST" action="/admin/vans" class="form-grid"><label>Van name<input name="name" required></label><label>Plate number<input name="plateNumber" required></label><label>Seat capacity<input type="number" name="capacity" min="1" required></label><label>Status<select name="status"><option>Available</option><option>Maintenance</option><option>Inactive</option></select></label><button class="btn btn-primary">Add Van</button></form></section><div class="manage-list"><% items.forEach(x=>{ %><form class="manage-row" method="POST" action="/admin/vans/<%= x._id %>/update"><label>Van name<input name="name" value="<%= x.name %>"></label><label>Plate number<input name="plateNumber" value="<%= x.plateNumber %>"></label><label>Capacity<input type="number" name="capacity" value="<%= x.capacity %>"></label><label>Status<select name="status"><% ["Available","Maintenance","Inactive"].forEach(s=>{ %><option <%= x.status===s?"selected":"" %>><%= s %></option><% }) %></select></label><button class="btn btn-primary btn-small">Save</button><button class="btn btn-danger btn-small" formaction="/admin/vans/<%= x._id %>/delete" formmethod="POST" onclick="return confirm('Delete this van?')">Delete</button></form><% }) %></div><%- include("../partials/admin-shell-end") %>