<%- include("partials/user-shell-start") %><section class="confirm-card"><div class="success-mark">✓</div><h1>Booking Confirmed!</h1><p class="muted">Your seat reservation has been successfully recorded.</p><div class="receipt"><p><span>Booking Number</span><b><%= booking.bookingNumber %></b></p><p><span>Passenger</span><b><%= booking.passenger.fullName %></b></p><p><span>Route</span><b><%= booking.schedule.route.origin %> → <%= booking.schedule.route.destination %></b></p><p><span>Date & time</span><b><%= new Date(booking.schedule.departureAt).toLocaleString() %></b></p><p><span>Seats</span><b><%= booking.seats.join(", ") %></b></p><p><span>Total</span><b>₱<%= booking.total %></b></p><p><span>Status</span><b class="status confirmed"><%= booking.status %></b></p></div><div class="actions center"><a href="/bookings" class="btn btn-primary">View My Bookings</a><a href="/trips" class="btn btn-outline">Find another trip</a></div></section><%- include("partials/user-shell-end") %>