<%- include("partials/head") %><%- include("partials/nav") %><main class="auth-wrap"><div class="auth-card"><div class="logo-large">🚐</div><h1>Create account</h1><p class="muted">Join VanBooking and reserve your seat</p><%- include("partials/flash") %><form method="POST" action="/register" class="form-stack"><label>Full name<input name="fullName" required></label><label>Email address<input type="email" name="email" required></label><label>Phone number<input name="phone" required></label><label>Password<input type="password" name="password" minlength="6" required></label><label>Confirm password<input type="password" name="confirmPassword" minlength="6" required></label><button class="btn btn-primary full">Create Account</button></form><p class="auth-foot">Already registered? <a href="/login">Login</a></p></div></main><%- include("partials/end") %>