<%- include("partials/user-shell-start") %><section class="panel narrow"><h2>My Profile</h2><form method="POST" action="/profile" class="form-stack"><label>Full name<input name="fullName" value="<%= user.fullName %>" required></label><label>Email address<input value="<%= user.email %>" disabled></label><label>Phone number<input name="phone" value="<%= user.phone %>" required></label><button class="btn btn-primary">Save Changes</button></form></section><%- include("partials/user-shell-end") %>