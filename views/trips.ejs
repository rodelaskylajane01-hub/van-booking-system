<%- include("partials/user-shell-start") %><section class="panel"><form method="GET" action="/trips" class="search-grid"><label>From<select name="from"><option value="">All departure points</option><% routes.forEach(r=>{ %><option <%= filters.from===r.origin?"selected":"" %>><%= r.origin %></option><% }) %></select></label><label>To<select name="to"><option value="">All destinations</option><% [...new Set(routes.map(r=>r.destination))].forEach(d=>{ %><option <%= filters.to===d?"selected":"" %>><%= d %></option><% }) %></select></label><label>Date<input type="date" name="date" value="<%= filters.date||'' %>"></label><button class="btn btn-primary">Search Trips</button></form></section><div class="section-title"><h2>Available Trips</h2><span class="muted"><%= schedules.length %> trip(s) found</span></div><div class="trip-list"><% schedules.forEach(s=>{ const booked=bookedBySchedule[String(s._id)]||[]; %><article class="trip-card"><div class="van-thumb">🚐</div><div class="trip-info"><h3><%= s.route.origin %> <span>→</span> <%= s.route.destination %></h3><p>📅 <%= new Date(s.departureAt).toLocaleString() %></p><p>♙ <%= s.van.name %> · <%= s.van.plateNumber %></p><p class="seat-note"><%= Math.max(0,s.van.capacity-booked.length) %> seats available · <%= booked.length %> occupied</p></div><div class="trip-price"><b>₱<%= s.fare %></b><small>per seat</small><a class="btn btn-primary btn-small" href="/trips/<%= s._id %>/seats">Select</a></div></article><% }) %><% if(!schedules.length){ %><div class="empty-state">No scheduled trips found. Please try another date or route.</div><% } %></div><%- include("partials/user-shell-end") %>