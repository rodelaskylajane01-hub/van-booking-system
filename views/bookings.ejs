<%- include("partials/user-shell-start") %><section class="panel table-wrap"><table><thead><tr><th>Booking No.</th><th>Passenger</th><th>Route</th><th>Departure</th><th>Seats</th><th>Total</th><th>Status</th><th>Action</th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><b><%= b.bookingNumber %></b></td><td><%= b.passenger?b.passenger.fullName:"—" %></td><td><%= b.schedule&&b.schedule.route?b.schedule.route.origin+" → "+b.schedule.route.destination:"Trip removed" %></td><td><%= b.schedule?new Date(b.schedule.departureAt).toLocaleString():"—" %></td><td><%= b.seats.join(", ") %></td><td>₱<%= b.total %></td><td><span class="status <%= b.status.toLowerCase() %>"><%= b.status %></span></td><td><% if(b.status==="Confirmed"){ %><form method="POST" action="/bookings/<%= b._id %>/cancel" onsubmit="return confirm('Cancel this booking?')"><button class="btn btn-danger btn-small">Cancel</button></form><% } %></td></tr><% }) %><% if(!bookings.length){ %><tr><td colspan="8" class="empty-cell">No bookings recorded yet.</td></tr><% } %></tbody></table></section><%- include("partials/user-shell-end") %>